# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/wcpool?sslmode=require

# ── Required in production ────────────────────────────────────────────────────
# Sets the secure flag on session cookies. Must be "production" in prod;
# leave unset or set to "development" locally.
NODE_ENV=production

# ── Optional — live score sync ────────────────────────────────────────────────
# API-Football key (api-football.com). Without this, live score sync is disabled.
# API_FOOTBALL_KEY=your_key_here

# ── Server (adapter-node defaults) ───────────────────────────────────────────
# PORT=3000
# HOST=0.0.0.0
# SHUTDOWN_TIMEOUT=30

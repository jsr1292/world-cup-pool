{
	"name": "world-cup-pool",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"migrate": "tsx src/lib/server/migrate.ts",
		"seed": "tsx src/lib/server/seed.ts",
		"seed:matches": "tsx src/lib/server/seed-matches.ts",
		"setup": "npm run migrate && npm run seed && npm run seed:matches",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/nodemailer": "^8.0.0",
		"@types/pg": "^8.20.0",
		"@types/web-push": "^3.6.4",
		"drizzle-kit": "^0.31.10",
		"playwright": "^1.59.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.22.3",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"nodemailer": "^8.0.10",
		"pg": "^8.21.0",
		"svelte-dnd-action": "^0.9.69",
		"web-push": "^3.6.7"
	}
}
